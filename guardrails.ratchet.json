{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 2,
    "antelopejs/no-presence-only-type-guard": 2,
    "anti-slop/no-known-value-widening": 1,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 16,
    "anti-slop/no-unknown-returns": 2,
    "anti-slop/require-safety-comment-for-type-assertion": 1,
    "typescript/no-unsafe-argument": 85,
    "typescript/no-unsafe-assignment": 102,
    "typescript/no-unsafe-return": 19
  },
  "oversizeFiles": {}
}
