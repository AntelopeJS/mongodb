{
  "name": "@antelopejs/mongodb",
  "version": "1.6.0",
  "description": "MongoDB backend for AntelopeJS, implementing the Database and MongoDB interfaces with the official MongoDB driver",
  "keywords": [
    "antelopejs",
    "database",
    "mongodb",
    "nosql"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/mongodb/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/mongodb.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test . && pnpm run test:external:run",
    "test:external": "pnpm run build && pnpm run test:external:run",
    "test:external:run": "MONGO_TEST_MODE=external ajs module test . $(for file in dist/test-external/*.test.js; do printf -- '-f %s ' \"$file\"; done)",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "tsc --noEmit",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-beec46b.tgz",
    "@antelopejs/interface-database-catalog": ">=0.0.3 <0.1.0",
    "chai": "^4.5.0",
    "mongodb": "^6.21.0",
    "randomstring": "^1.3.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/randomstring": "^1.3.0",
    "@types/semver": "^7.7.1",
    "@types/sinon": "^17.0.4",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server-core": "^10.4.3",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-mongodb": ">=0.0.6 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-beec46b.tgz"
    }
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-database-catalog",
      "@antelopejs/interface-mongodb"
    ],
    "defaultConfig": {
      "url": "mongodb://localhost:27017",
      "database": "antelopejs"
    },
    "test": "src/test/antelope.test.ts"
  }
}
