{
  "name": "@antelopejs/mongodb",
  "version": "1.2.7",
  "description": "MongoDB module that implements the Database interface of antelopejs",
  "keywords": [
    "antelopejs",
    "mongodb",
    "database",
    "nosql",
    "orm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/mongodb.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-mongodb"
    ],
    "defaultConfig": {
      "url": "mongodb://localhost:27017",
      "database": "antelopejs"
    },
    "test": "src/test/antelope.test.ts"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-mongodb": ">=0.0.3 <1.0.0",
    "chai": "^4.5.0",
    "mongodb": "^6.21.0",
    "randomstring": "^1.3.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/randomstring": "^1.3.0",
    "@types/semver": "^7.7.1",
    "@types/sinon": "^17.0.4",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^10.4.3",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
